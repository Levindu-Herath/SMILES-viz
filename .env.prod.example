# Runtime config for docker-compose.prod.yml on the EC2 box.
# Copy to .env.prod ON THE BOX ONLY and fill in. Never commit .env.prod.

# --- Images to pull ---
ECR_REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com
# Full git SHA of the release that is running. Written by scripts/deploy.sh on
# every deploy/rollback — this line is the box's record of what's live.
IMAGE_TAG=<full-40-char-git-sha>

# --- Backend runtime (Supabase Dashboard -> Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Exact browser origin(s) allowed by the backend, comma-separated, no trailing slash ---
CORS_ORIGINS=https://molytica.duckdns.org

DEBUG=false
