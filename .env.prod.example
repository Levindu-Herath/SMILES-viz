# Runtime config for docker-compose.prod.yml on the EC2 box.
# Copy to .env.prod ON THE BOX ONLY and fill in. Never commit .env.prod.

# --- Images to pull (ECR URI + immutable tag, e.g. the git SHA) ---
BACKEND_IMAGE=<account-id>.dkr.ecr.<region>.amazonaws.com/smiles-viz-backend:<git-sha>
FRONTEND_IMAGE=<account-id>.dkr.ecr.<region>.amazonaws.com/smiles-viz-frontend:<git-sha>-prod

# --- Backend runtime (Supabase Dashboard -> Project Settings -> API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Exact browser origin(s) allowed by the backend, comma-separated, no trailing slash ---
CORS_ORIGINS=https://molytica.duckdns.org

DEBUG=false
